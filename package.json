{
  "name": "support-agent",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6",
      "lucide-react": "^1.23.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.7",
      "react-dom": "^19.2.7",
      "sonner": "^2.0.7",
      "convex": "^1.42.1",
      "better-auth": "1.6.15",
      "@convex-dev/better-auth": "^0.12.5",
      "@tailwindcss/postcss": "^4.3.2",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.3.2"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "dev:web": "turbo run dev -F web",
    "dev:server": "turbo run dev -F @support-agent/backend",
    "dev:setup": "turbo run dev:setup -F @support-agent/backend",
    "lint": "oxlint && eslint packages/backend/convex",
    "prepare": "husky"
  },
  "dependencies": {
    "@flue/runtime": "^1.0.0-beta.9",
    "@support-agent/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^2.0.0",
    "@flue/cli": "^1.0.0-beta.9",
    "@support-agent/config": "workspace:*",
    "@types/node": "^22.13.14",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^9",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "turbo": "^2.10.2",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}": [
      "oxfmt",
      "oxlint --no-error-on-unmatched-pattern"
    ],
    "packages/backend/convex/**/*.ts": "eslint --no-warn-ignored"
  },
  "packageManager": "bun@1.3.14"
}
